# Copy to .env on the target server. Keep real values out of Git.
# Required: set a unique administrator password before docker compose up.
ASAP_ADMIN_PASSWORD=
# Use 0 for the initial loopback-only HTTP check; set 1 behind domain HTTPS.
ASAP_COOKIE_SECURE=0
# Existing LinkedIn developer app credentials; optional until domain setup.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# Optional email transport. Enable a recipient in the app Settings afterwards.
ASAP_SMTP_HOST=
ASAP_SMTP_PORT=587
ASAP_SMTP_SECURITY=starttls
ASAP_SMTP_FROM=
ASAP_SMTP_USERNAME=
ASAP_SMTP_PASSWORD=

# Stage 2 Google OIDC (Web application client; Gmail SMTP app password is unrelated)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://asap.surf/auth/google/callback
# Set to 1 only behind exactly one trusted reverse proxy, e.g. Jarvis Caddy.
ASAP_TRUST_PROXY=0
